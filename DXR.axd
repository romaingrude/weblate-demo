/* ASPxBinaryImage*/
.dxeTopSys
{
    position: absolute;
    top: 0;
}
.dxeBottomSys
{
    bottom: 0;
    position: absolute;
}
.dxeFillParentSys
{
    height: 100%;
    left: 0;
    position: absolute;
    top: 0;
    width: 100%;
}
.dxIE *[dir="rtl"] .dxeFillParentSys { 
    left: auto; 
}
.dxeTblSys
{
    display: table;
}
.dxeInlineTblSys
{
    border-spacing: 0;
    display: inline-table;
}
.dxeRowSys
{
    display: table-row;
}
.dxeCellSys
{
    display: table-cell;
    vertical-align: middle;
}
.dxeBinImgSys
{
    border: dashed 1px gray;
    font-family: Tahoma, Geneva, sans-serif;
    height: 150px;
    width: 150px;
}
.dxeBinImgSys > .dxeCellSys
{
    height: 100%;
