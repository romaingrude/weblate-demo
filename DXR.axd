}
.dxIE.dxBrowserVersion-10 .dxeCalendar_LilacMaterial td.dxMonthGridWithWeekNumbers > table > tbody > tr:last-child > td,
.dxIE.dxBrowserVersion-10 .dxeCalendar_LilacMaterial td.dxMonthGrid > table > tbody > tr:last-child > td
{
    background-repeat: no-repeat;
    background-position: center -5px;
    background-size: 40px 58px;
}
