/* -- Calendar -- */
.dxeCalendar_LilacMaterial
{
    background-color: White;
    color: #484848;
    font-weight: normal;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;font-weight:bold;
    cursor: default;
    border: 1px solid #D9D9D9;
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    -o-border-radius: 2px;
    -khtml-border-radius: 2px;
    border-radius: 2px;
    border-collapse: separate;
}
.dxeCalendarFooter_LilacMaterial
{
    border-top: 1px solid #EAEAEA;
}
.dxeCalendar_LilacMaterial td.dxMonthGridWithWeekNumbers > table > tbody > tr > td:first-child
{
