}
.dxeCalendarSelected_LilacMaterial
{
    color: white;
}
.dxeCalendarSelected_LilacMaterial,
.dxeCalendarToday_LilacMaterial
{
    background-repeat: no-repeat;
    background-position: center 3px;
    background-size: 40px 40px;
}
.dxeCalendar_LilacMaterial td.dxMonthGridWithWeekNumbers > table > tbody > tr > td:nth-child(2).dxeCalendarSelected_LilacMaterial,
.dxeCalendar_LilacMaterial td.dxMonthGridWithWeekNumbers > table > tbody > tr > td:nth-child(2).dxeCalendarToday_LilacMaterial
{
