    border-right-width: 1px;
    border-right-style: none !important;
    float: left;
    clear: none;
}
/* -- ASPxTitleIndex -- */
.dxtiControl_LilacMaterial
{
    color: #B08EBF;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
}
.dxtiControl_LilacMaterial a
{
    color: #B08EBF;
}
.dxtiItem_LilacMaterial
{
    white-space: nowrap;
}
.dxtiGroupHeader_LilacMaterial,
.dxtiGroupHeaderCategorized_LilacMaterial
{
    font-size: 1.5em;
    text-decoration: none;
}
.dxtiGroupHeader_LilacMaterial,
.dxtiGroupHeaderCategorized_LilacMaterial
{
    white-space: nowrap;
    padding: 0 0 8px;
}
.dxtiControl_LilacMaterial .dxti-i
{
    padding-bottom: 10px;
    text-decoration: none;
}
.dxtiControl_LilacMaterial .dxti-i a
{
    text-decoration: none;
}
.dxtiControl_LilacMaterial .dxti-i a:hover
{
    text-decoration: underline;
}
/* - GroupHeaderText - */
.dxtiGroupHeaderText_LilacMaterial
{
    color: #484848;
}
.dxtiGroupHeaderText_LilacMaterial
{
    padding: 0px 1px 11px;
}
.dxtiGroupHeaderTextCategorized_LilacMaterial
{
    color: #484848;
}
.dxtiGroupHeaderTextCategorized_LilacMaterial
{
    padding: 1px 8px;
}
/* - FilterBox - */
.dxtiFilterBoxInfoText_LilacMaterial
{
    font-size: 0.75em;
    font-weight: normal;
    color: #999999;
    padding: 2px 0;
}
.dxtiFilterBoxEdit_LilacMaterial
{
    border: 1px Solid #E5E5E5;
    width: 100%;
    height: 26px;
}
.dxtiFilterBox_LilacMaterial > table table tr:first-child td:last-child
{
    width: 100%;
}
.dxtiFilterBox_LilacMaterial table
{
    color: #484848;
    width: 100%;
}
.dxtiFilterBox_LilacMaterial
{
    padding: 14px 6px 13px 2px;
    border-bottom: 1px solid #E5E5E5;
}
.dxtiControl_LilacMaterial[dir="rtl"] .dxtiFilterBox_LilacMaterial
{
    padding: 14px 2px 13px 6px;
}
/* - IndexPanel - */
.dxtiIndexPanel_LilacMaterial
{
    font-size: 1.33em;
    padding: 10px 0 22px;
    text-decoration: none;
}
.dxtiControl_LilacMaterial[dir="rtl"] .dxtiIndexPanel_LilacMaterial > table > tbody > tr > td
{
    text-align: right !important;
    padding-right: 5px;
}
.dxtiControl_LilacMaterial .dxtiIndexPanel_LilacMaterial > table > tbody > tr > td
{
    padding-left: 5px;
}
.dxtiControl_LilacMaterial .dxtiIndexPanel_LilacMaterial .dxtiIndexPanelItem_LilacMaterial a
{
    text-decoration: none;
}
.dxtiControl_LilacMaterial .dxtiIndexPanel_LilacMaterial .dxtiIndexPanelItem_LilacMaterial a:hover
{
    text-decoration: underline;
}
.dxtiIndexPanelItem_LilacMaterial,
.dxtiCurrentIndexPanelItem_LilacMaterial
{
    text-decoration: none;
}
.dxtiIndexPanelItem_LilacMaterial.dxtiCurrentIndexPanelItem_LilacMaterial:first-child
{
    padding: 4px 8px 4px 8px;
    margin-left: -8px;
}
.dxtiIndexPanelItem_LilacMaterial:first-child
{
    padding: 0 8px 0 0;
}
.dxtiControl_LilacMaterial[dir="rtl"] .dxtiIndexPanelItem_LilacMaterial:first-child
{
    padding: 0 0 0 8px;
}
.dxtiIndexPanelItem_LilacMaterial
{
    padding: 4px 8px;
}
/*.dxtiControl_LilacMaterial[dir="rtl"] .dxtiIndexPanelItem_LilacMaterial
{
    padding: 0 0 0 11px;
}*/
.dxtiCurrentIndexPanelItem_LilacMaterial
{
    color: #FFFFFF;
    background: url('DXR-7.axd');
    background-size: 100% 100%;
    background-position: center center;
}
/* - BackToTop - */
.dxtiBackToTop_LilacMaterial,
.dxtiBackToTop_LilacMaterial a
{
    color: #FFFFFF;
    text-decoration: none;
}
.dxtiControl_LilacMaterial[dir="rtl"] .dxtiBackToTop_LilacMaterial
{
    text-align: left !important;
}
.dxtiBackToTop_LilacMaterial a:first-child:hover + a
{
    visibility: visible;
}
.dxIE .dxtiBackToTop_LilacMaterial img
{
    margin: -80px 16px 0 0;
}
.dxtiBackToTop_LilacMaterial a:last-child
{
    visibility: hidden;
    padding: 3px 8px;
    background-color: #707070;
    border-radius: 2px;
}
.dxtiBackToTop_LilacMaterial
{
    padding: 80px 0px;
    text-align: right !important;
}
.dxtiBackToTopRtl_LilacMaterial
{
    padding: 80px 0px;
}
.dxtiControl_LilacMaterial[dir="rtl"] .dxtiBackToTop_LilacMaterial img
{
    float: left;
    margin: -66px 0 0 16px;
}
.dxtiBackToTop_LilacMaterial img
{
    float: right;
    margin: -66px 16px 0 0;
    border-radius: 50%;
    background-color: #f9f9f9;
    -moz-box-shadow: 0px 10px 14.1px 0.9px rgba(0,0,0,0.24);
    -webkit-box-shadow: 0px 10px 14.1px 0.9px rgba(0,0,0,0.24);
    box-shadow: 0px 10px 14.1px 0.9px rgba(0,0,0,0.24);
}
/* Disabled */
.dxtiDisabled_LilacMaterial,
.dxtiDisabled_LilacMaterial a
{
    color: #b8b8b8;
    cursor: default !important;
}
/* -- ASPxUploadControl -- */
.dxucControl_LilacMaterial,
.dxucEditArea_LilacMaterial,
input[type="text"].dxucEditArea_LilacMaterial
{
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
}
.dxucControl_LilacMaterial,
.dxucEditArea_LilacMaterial,
body input.dxucEditArea_LilacMaterial
{
    color: #484848;
}
.dxucEditArea_LilacMaterial,
input[type="text"].dxucEditArea_LilacMaterial
{
    padding: 1px;
}
.dxucControl_LilacMaterial .dxucInputs_LilacMaterial
{
    border-collapse: separate;
    border-width: 0;
}
.dxucTextBox_LilacMaterial
{
    background-color: white;
    border: 1px solid #DFDFDF;
    padding: 1px 8px;
}
.dxucTextBox_LilacMaterial.dxTB
{
    border-radius: 2px 0 0 2px;
    -webkit-border-radius: 2px 0 0 2px;
}
.dxucTextBox_LilacMaterial .dxucEditArea_LilacMaterial
{
    margin: 0px;
    background-color: white;
}
.dxucNullText_LilacMaterial .dxucEditArea_LilacMaterial
{
    color: #C4C4C4;
}
.dxucErrorCell_LilacMaterial
{
    color: Red;
    text-align: left;
}
.dxucButton_LilacMaterial,
.dxucButton_LilacMaterial a
{
    color: #B08EBF;
    white-space: nowrap;
}
.dxucBrowseButton_LilacMaterial,
.dxucBrowseButton_LilacMaterial a
{
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
}
.dxucControl_LilacMaterial .dxucBrowseButton_LilacMaterial a
{
    color: #484848;
}
.dxucControl_LilacMaterial a[unselectable="on"]
{
    user-select: none;
    -moz-user-select: -moz-none;
    -khtml-user-select: none;
    -webkit-user-select: none;
}
.dxucBrowseButton_LilacMaterial
{
    border: 1px solid #DFDFDF;
    padding: 6px 18px 8px;
    background-color: #EEEEEE;
    border-radius: 0 2px 2px 0;
    -webkit-border-radius: 0 2px 2px 0;
}
.dxucBrowseButton_LilacMaterial.dxbf
{
    padding: 6px 17px 8px;
}
.dxucBrowseButton_LilacMaterial.dxbf a
{
    border: 1px dotted black;
}
*[dir="rtl"] .dxucBrowseButtonHover_LilacMaterial
{
    border-radius: 3px 0 0 3px;
    -webkit-border-radius: 3px 0 0 3px;
}
*[dir="rtl"] .dxucBrowseButtonHover_LilacMaterial
{
    border-radius: 3px 0 0 3px;
    -webkit-border-radius: 3px 0 0 3px;
}
.dxucBrowseButtonHover_LilacMaterial
{
    background-color: #B08EBF;
    color: #FFFFFF;
    border-radius: 0 3px 3px 0;
    -webkit-border-radius: 0 3px 3px 0;
}
.dxucBrowseButtonPressed_LilacMaterial
{
    background-color: #B08EBF;
    color: #FFFFFF;
}
/* Upload control - Ripple */
.dxucBrowseButton_LilacMaterial::before
{
    content: "dxRippleTarget";
    display: none;
}
.dxucBrowseButton_LilacMaterial .dxRipple
{
    background-color: rgba(255,255,255,0.3);
}
/* ProgressBar */
.dxucProgressBar_LilacMaterial
{
    background-color: #E0E0E0;
    height: 23px;
}
.dxucProgressBar_LilacMaterial,
.dxucProgressBar_LilacMaterial td.dx
{
    color: #484848;
}
.dxucProgressBar_LilacMaterial .dxPBMainCell,
.dxucProgressBar_LilacMaterial td.dx
{
    padding: 0;
}
.dxucProgressBarIndicator_LilacMaterial
{
    background-color: #B08EBF;
}
/* Silverlight Plugin Link */
.dxucSilverlightPluginLinkPanel_LilacMaterial
{
    font-size: 0.75em;
    color: #7d7d7d;
