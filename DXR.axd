}
/* -- ASPxNewsControl -- */
.dxncControl_LilacMaterial
{
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
    color: #484848;
    background-color: White;
}
.dxncControl_LilacMaterial a
{
    color: #B08EBF;
}
.dxncControl_LilacMaterial td.dxncCtrl_LilacMaterial
{
    padding: 18px;
}
.dxncPagerPanel_LilacMaterial
{
    padding: 0px 3px;
}
.dxncItem_LilacMaterial
{
    vertical-align: top;
    padding: 12px 8px 10px;
}
.dxncEmptyItem_LilacMaterial
{
    vertical-align: top;
    padding: 12px 12px 12px 14px;
}
.dxncBackToTop_LilacMaterial,
.dxncBackToTop_LilacMaterial a
{
    color: #FFFFFF;
    text-decoration: none;
}
.dxncControl_LilacMaterial[dir="rtl"] .dxncBackToTop_LilacMaterial
{
    text-align: left !important;
    float: left !important;
}
.dxncBackToTop_LilacMaterial a:first-child:hover + a
{
    visibility: visible;
}
.dxncBackToTop_LilacMaterial a:last-child
{
    visibility: hidden;
    padding: 3px 8px;
    background-color: #707070;
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    -o-border-radius: 2px;
    -khtml-border-radius: 2px;
    border-radius: 2px;
}
.dxncBackToTop_LilacMaterial
{
    padding: 60px 0 0 0;
    text-align: right !important;
}
.dxtiBackToTopRtl_LilacMaterial
{
    padding: 60px 0 0 0;
}
.dxncControl_LilacMaterial[dir="rtl"] .dxncBackToTop_LilacMaterial img
{
    float: left;
    margin: -66px 0 0 16px;
}
.dxncBackToTop_LilacMaterial img
{
    float: right;
    margin: -66px 16px 0 0;
    border-radius: 50%;
    background-color: #f9f9f9;
    box-shadow: 0 0 50px black;
    -moz-box-shadow: 0px 10px 14.1px 0.9px rgba(0,0,0,0.24);
    -webkit-box-shadow: 0px 10px 14.1px 0.9px rgba(0,0,0,0.24);
}
.dxncPagerShowMoreItemsContainer_LilacMaterial
{
    height: 48px;
    text-align: center;
}
.dxncPagerShowMoreItemsContainer_LilacMaterial a
{
    display: block;
    padding-top: 12px;
    color: #B08EBF;
}
.dxncControl_LilacMaterial .dxhlTailDiv_LilacMaterial a
{
    color: #999999;
}
.dxncEmptyData_LilacMaterial
{
    color: Gray;
}
/* Disabled */
.dxncDisabled_LilacMaterial
{
    color: #b8b8b8;
    cursor: default;
}
/* -- ASPxPager Lite -- */
.dxpLite_LilacMaterial
{
