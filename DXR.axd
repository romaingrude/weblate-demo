.dxmLite_LilacMaterial.dxm-side-menu-mode .dxm-side-menu-button > div:before,
.dxmLite_LilacMaterial.dxm-side-menu-mode .dxm-side-menu-button > div:after
{
    background-color: #fff;
}
.dxmLite_LilacMaterial.dxm-side-menu-mode .dxm-bread-crumbs
{
    box-shadow: 0px 1px 6px 0px rgba(0,0,0,0.15);
