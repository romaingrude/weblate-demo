}
.dxnbLite_LilacMaterial .dxnb-header .dxRipple,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-itemHover.dxnb-item .dxRipple,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-largeHover.dxnb-large .dxRipple,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-bulletHover.dxnb-bullet .dxRipple
{
