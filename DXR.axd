/* -- ASPxNavBar Lite -- */
.dxnbLite_LilacMaterial
{
    color: #484848;
    background-color: white;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
    list-style: none none outside;
    margin: 0;
    padding: 0px;
    float: left;
    width: 200px;
}
.dxnbLite_LilacMaterial a
{
    color: #B08EBF;
    text-decoration: none;
}
.dxnbLite_LilacMaterial a:hover
{
    text-decoration: underline;
}
.dxnbLite_LilacMaterial .dxnb-gr
{
    margin-bottom: 13px;
}
.dxnbLite_LilacMaterial div.dxnb-headerCollapsed
{
    background-color: #EEEEEE;
}
.dxnbLite_LilacMaterial .dxnb-last .dxnb-headerCollapsed,
.dxnbLite_LilacMaterial .dxnb-last .dxnb-content,
.dxnbLite_LilacMaterial li:last-child.dxnb-gr > .dxnb-headerCollapsed
{
    border-bottom: 1px solid #DFDFDF;
}
.dxnbLite_LilacMaterial .dxnb-header,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed
{
    background-color: #EEEEEE;
    padding: 15px 10px 11px;
    color: #484848;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;font-weight:bold;
    font-size: 1em;
    white-space: nowrap;
    border: 1px solid #DFDFDF;
    border-bottom: none;
}
.dxnbLite_LilacMaterial .dxnb-header a,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed a
{
    color: #B08EBF;
    text-decoration: none;
}
.dxnbLite_LilacMaterial .dxnb-header a:hover,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed a:hover
{
    text-decoration: underline;
}
.dxnbLite_LilacMaterial .dxnb-content
{
    list-style: none none outside;
    margin: 0;
    padding: 0px;
    overflow: hidden;
    border: 1px solid #DFDFDF;
    border-bottom: none;
    background-color: #FAFAFA;
}
.dxnbLite_LilacMaterial.dxnb-noHeads .dxnb-content
{
    border-top-width: 1px;
}
.dxnbLite_LilacMaterial .dxnb-content
.dxnbLite_LilacMaterial .dxnb-item,
.dxnbLite_LilacMaterial .dxnb-large,
.dxnbLite_LilacMaterial .dxnb-bullet
{
    color: black;
    clear: both;
    overflow: hidden;
    cursor: default;
    border-bottom: 1px solid #DFDFDF;
}
.dxnbLite_LilacMaterial .dxnb-item,
.dxnbLite_LilacMaterial .dxnb-large,
.dxnbLite_LilacMaterial .dxnb-tmpl,
.dxnbLite_LilacMaterial .dxnb-bullet
{
    margin-bottom: 1px;
}
.dxnbLite_LilacMaterial .dxnb-item.dxnb-link,
.dxnbLite_LilacMaterial .dxnb-item .dxnb-link,
.dxnbLite_LilacMaterial .dxnb-bullet.dxnb-link
{
    padding: 7px 33px 8px 33px;
    white-space: nowrap;
}
.dxnbLite_LilacMaterial .dxnb-large.dxnb-link,
.dxnbLite_LilacMaterial .dxnb-large .dxnb-link
{
    padding: 6px 12px 7px;
    white-space: nowrap;
}
.dxnbLite_LilacMaterial .dxnb-bullet,
.dxnbLite_LilacMaterial .dxnb-bulletHover,
.dxnbLite_LilacMaterial .dxnb-bulletSelected
{
    overflow: visible;
}
.dxnbLite_LilacMaterial .dxnb-itemSelected,
.dxnbLite_LilacMaterial .dxnb-largeSelected,
.dxnbLite_LilacMaterial .dxnb-bulletSelected
{
    background-color: #f0f0f0;
}
.dxnbLite_LilacMaterial .dxnb-itemHover,
.dxnbLite_LilacMaterial .dxnb-largeHover,
.dxnbLite_LilacMaterial .dxnb-bulletHover
{
    background-color: #B08EBF;
    color: #FFFFFF;
}
.dxnbLite_LilacMaterial .dxnb-itemHover a,
.dxnbLite_LilacMaterial .dxnb-largeHover a,
.dxnbLite_LilacMaterial .dxnb-bulletHover a
{
    color: #FFFFFF;
}
.dxnbLite_LilacMaterial .dxnb-header,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed,
.dxnbLite_LilacMaterial .dxnb-item,
.dxnbLite_LilacMaterial .dxnb-itemHover,
.dxnbLite_LilacMaterial .dxnb-itemSelected,
.dxnbLite_LilacMaterial .dxnb-bullet,
.dxnbLite_LilacMaterial .dxnb-bulletHover,
.dxnbLite_LilacMaterial .dxnb-bulletSelected
{
