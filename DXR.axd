{
    flex: 1 1 auto;
}
.dxtc-wkt .dxtc-alLeft .dxtc-rightIndent
{
    -webkit-flex: 1 1 auto;
}
.dxtc-flex .dxtc-alRight
{
    justify-content: flex-end;
}
.dxtc-wkt .dxtc-alRight
{
    -webkit-justify-content: flex-end;
}
