}
.dxnbLite_LilacMaterial .dxnb-large,
.dxnbLite_LilacMaterial .dxnb-largeHover,
.dxnbLite_LilacMaterial .dxnb-largeSelected
{
    text-align: center;
}
.dxnbLite_LilacMaterial .dxnb-item.dxnb-last,
.dxnbLite_LilacMaterial .dxnb-large.dxnb-last
{
    margin-bottom: 0;
    border-bottom: 0;
}
.dxnbLite_LilacMaterial .dxnb-btn,
.dxnbLite_LilacMaterial .dxnb-btnLeft,
.dxnbLite_LilacMaterial .dxnb-img
{
    border-width: 0;
}
.dxnbLite_LilacMaterial .dxnb-btn
{
    float: right;
    margin: 0 0 0 4px;
}
.dxnbLite_LilacMaterial .dxnb-btnLeft,
.dxnbLite_LilacMaterial .dxnb-rtlHeader .dxnb-btn
{
    float: left;
    margin: 0 10px 0 0;
}
.dxnbLite_LilacMaterial .dxnb-img
{
    margin: 0 4px 0 0;
}
.dxnbLite_LilacMaterial .dxnb-right .dxnb-item .dxnb-img,
.dxnbLite_LilacMaterial .dxnb-rtlHeader .dxnb-img
{
    margin: 0 0 0 4px;
}
.dxnbLite_LilacMaterial .dxnb-header.dxnb-header-left,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed.dxnb-header-left,
.dxnbLite_LilacMaterial .dxnb-rtlHeader
{
    text-align: right;
}
.dxnbLite_LilacMaterial .dxnb-top .dxnb-large .dxnb-img
{
    margin-bottom: 3px;
}
.dxnbLite_LilacMaterial .dxnb-bottom .dxnb-large .dxnb-img
{
    margin-top: 3px;
}
.dxnbLite_LilacMaterial .dxnb-large .dxnb-img
{
    display: block;
    margin-left: auto;
    margin-right: auto;
}
.dxnbLiteDisabled_LilacMaterial,
.dxnbLite_LilacMaterial .dxnbLiteDisabled_LilacMaterial,
.dxnbLiteDisabled_LilacMaterial a,
.dxnbLiteDisabled_LilacMaterial .dxnb-item,
.dxnbLiteDisabled_LilacMaterial .dxnb-large,
.dxnbLiteDisabled_LilacMaterial .dxnb-bullet,
.dxnbLiteDisabled_LilacMaterial .dxnb-header,
.dxnbLiteDisabled_LilacMaterial .dxnb-headerCollapsed
{
