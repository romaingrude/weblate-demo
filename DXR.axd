{
    background-color: #DDDDDD;
}*/
/* Disabled */
.dxbDisabled_LilacMaterial,
a.dxbButton_LilacMaterial.dxbDisabled_LilacMaterial
{
    color: #BBBBBB;
    cursor: default;
    text-decoration: none;
}
a.dxbButton_LilacMaterial.dxbDisabled_LilacMaterial
{
    background: none !important;
}
/* -- FilterControl -- */
.dxfcControl_LilacMaterial
{
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
    color: Black;
    padding: 0 1em;
    padding-top: 14px;
}
.dxfcTable_LilacMaterial
{
    border-collapse: separate !important;
}
.dxfcTable_LilacMaterial td.dxfc
{
    padding: 0 0 0 3px;
}
.dxfcTable_LilacMaterial td.dxfc > table
{
    margin: 1px 0 -1px;
}
a.dxfcPropertyName_LilacMaterial
{
    white-space: nowrap !important;
    color: #B08EBF !important;
}
a.dxfcGroupType_LilacMaterial
{
    white-space: nowrap !important;
    padding: 0 3px !important;
    color: #db3412 !important;
}
a.dxfcOperation_LilacMaterial
{
    white-space: nowrap !important;
    color: #64B5F6 !important;
}
a.dxfcValue_LilacMaterial
{
    white-space: nowrap !important;
    color: Gray !important;
    padding-right: 4px !important;
}
.dxeMaskHint_LilacMaterial
{
    background: #ffffe1 none;
    border: 1px solid black;
    padding: 2px 5px 3px;
    color: Black;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;
}
.dxfcControl_LilacMaterial ul.dxfc-tree,
.dxfcControl_LilacMaterial .dxfc-tree ul
{
    list-style-type: none;
    margin: 0;
    overflow-y: hidden;
    padding: 0;
}
.dxfcControl_LilacMaterial .dxfc-tree
{
    width: 100%;
}
.dxfcControl_LilacMaterial .dxfc-subnd
{
    margin-left: 22px;
}
.dxfcControl_LilacMaterial.dxfcRtl .dxfc-subnd
{
    margin-left: 0;
    margin-right: 22px;
}
.dxfcControl_LilacMaterial .dxfc > li > table
{
    border-spacing: 0;
    border-collapse: collapse;
}
.dxfcControl_LilacMaterial .dxfc-elb
{
    float: left;
    height: 21px;
    vertical-align: top;
    width: 21px;
}
.dxfcControl_LilacMaterial.dxfcRtl .dxEditors_fcremove_LilacMaterial
{
    margin-right: 2px;
}
.dxfcControl_LilacMaterial .dxfc-clr
{
    clear: both;
    display: block;
    font-size: 0;
    height: 0;
    visibility: hidden;
    width: 0;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td
{
    vertical-align: top;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td.dxfc-editorCell
{
    vertical-align: middle;
}
.dxEditors_fcremove_LilacMaterial, .dxEditors_fcadd_LilacMaterial
{
    margin-top: 8px;
}
.dxfcControl_LilacMaterial .dxfc-nd
{
    cursor: pointer;
    display: block;
    float: left;
    outline: 0 none;
    text-decoration: none;
    vertical-align: middle;
    white-space: nowrap;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > a,
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > span,
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > img,
.dxfcControl_LilacMaterial .dxfc-editor
{
    vertical-align: middle;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td
{
    height: 32px;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > img
{
    margin-left: 2px;
}
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > a,
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > td,
.dxfcControl_LilacMaterial .dxfc-nd > tbody > tr > td > span,
.dxfcControl_LilacMaterial .dxfc-editor
{
