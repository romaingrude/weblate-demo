.dxnbLite_LilacMaterial .dxnb-header::before,
.dxnbLite_LilacMaterial .dxnb-headerCollapsed::before,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-item::before,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-large::before,
.dxnbLite_LilacMaterial .dxnb-content .dxnb-bullet::before
{
