	font: inherit;
	margin: 0px 0px 0px 4px;
	padding: 1px 0px 2px 5px;
    line-height: 16px;
    height: 16px;
	width: 60px;
}
.dxeButtonsPanelDivSys input
{
    font: inherit;
}
.dxeAutomaticColorItemSys {
