/* flex layout */
.dxtc-flex.dxtc-left,
.dxtc-flex.dxtc-right
{
    height: 1px;
}
.dxtcSys.dxtc-flex > .dxtc-stripContainer,
.dxtcSys.dxtc-flex > .dxtc-stripContainer .dxtc-strip
{
    display: flex;
}
