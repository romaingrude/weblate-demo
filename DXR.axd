{
    color: #d0d0d0;
}
.dxeCalendarDayDisabled_LilacMaterial
{
    opacity: 1.0;
    background-color: #fcfcfc;
    color: #ececec !important;
}
.dxeCalendarDay_LilacMaterial
{
    padding: 12px;
    text-align: center;
}
.dxeCalendarToday_LilacMaterial.dxeDisabled_LilacMaterial
{
    border: 1px solid #B08EBF;
}
