{
    color: #bbbbbb;
    text-decoration: none;
}
.dxeButtonDisabled_LilacMaterial
{
    border-color: #bbbbbb;
    color: #bbbbbb;
    cursor: default;
}
/* -- Button -- */
.dxbButton_LilacMaterial
{
    color: white;
    background-color: #B08EBF;
    -moz-box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
    -webkit-box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
    box-shadow: 0 2px 5px 0 rgba(0,0,0,0.16), 0 2px 10px 0 rgba(0,0,0,0.12);
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    -o-border-radius: 2px;
    -khtml-border-radius: 2px;
    border-radius: 2px;
    padding: 1px;
    font: 12px 'Roboto Regular', Helvetica, 'Droid Sans', Tahoma, Geneva, sans-serif;font-weight:bold;
    -webkit-transition-property: box-shadow, background-color;
    -moz-transition-property: box-shadow, background-color;
    -o-transition-property: box-shadow, background-color;
    transition-property: box-shadow, background-color;
    -webkit-transition-duration: .3s;
    -moz-transition-duration: .3s;
    -o-transition-duration: .3s;
    transition-duration: .3s;
    -webkit-transition-timing-function: ease-out;
    -moz-transition-timing-function: ease-out;
    -o-transition-timing-function: ease-out;
    transition-timing-function: ease-out;
    -webkit-tap-highlight-color: transparent;
}
.dxbButton_LilacMaterial.dxbTSys
{
    width: 96px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
}
.dxbButton_LilacMaterial.dxbDisabled_LilacMaterial
{
    border-color: #DDDDDD;
    background-color: #DDDDDD;
    color: #A2A2A2;
    cursor: default;
    box-shadow: none;
    -moz-box-shadow: none;
    -webkit-box-shadow: none;
}
.dxbButtonHover_LilacMaterial
{
    color: white;
    background-color: #B08EBF;
    box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
    -moz-box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
    -webkit-box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
}
.dxbButtonChecked_LilacMaterial
{
    color: white;
    background-color: #6D5877;
}
.dxbButtonPressed_LilacMaterial
{
    color: white;
    background-color: #B08EBF;
    box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
    -moz-box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
    -webkit-box-shadow: 0px 5px 6px rgba(0,0,0,0.2);
}
.dxbButton_LilacMaterial div.dxb
{
    padding: 6px 13px 4px;
    border: 1px dotted transparent;
}
.dxbButton_LilacMaterial div.dxbf
{
    border: 1px dotted;
}
div.dxbButton_LilacMaterial::before
{
    content: "dxRippleTarget";
    display: none;
}
div.dxbButton_LilacMaterial .dxRipple
{
    background-color: rgba(255,255,255,0.85);
}
.dxAndroidMobilePlatform div.dxbButton_LilacMaterial .dxRipple,
.dxMacOSMobilePlatform div.dxbButton_LilacMaterial .dxRipple
{
    background-color: rgba(255,255,255,0.9);
}
/* Button Link */
a.dxbButton_LilacMaterial
{
    color: #B08EBF;
    text-decoration: none;
    box-shadow: none;
    -moz-box-shadow: none;
    -webkit-box-shadow: none;
}
a.dxbButton_LilacMaterial:hover
{
    -webkit-border-radius: 2px;
    -moz-border-radius: 2px;
    -o-border-radius: 2px;
    -khtml-border-radius: 2px;
    border-radius: 2px;
    text-decoration: underline;
}
