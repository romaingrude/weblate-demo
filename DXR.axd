}
.dxpLite_LilacMaterial .dxp-pressedDropDownButton,
.dxpLite_LilacMaterial .dxp-hoverDropDownButton
{
    background-color: #B08EBF;
}
.dxFirefox .dxpLite_LilacMaterial .dxp-num,
.dxIE .dxpLite_LilacMaterial .dxp-num
{
    padding: 9px 12px 9px;
}
