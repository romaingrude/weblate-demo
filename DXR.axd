.dxtcLite_LilacMaterial.dxtc-left > .dxtc-stripContainer .dxtc-sbWrapper,
.dxtcLite_LilacMaterial.dxtc-left > .dxtc-stripContainer .dxtc-sbIndent,
.dxtcLite_LilacMaterial.dxtc-left > .dxtc-stripContainer .dxtc-sbSpacer
